
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #f1f5f9;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
}

.container {
    background: white;
    width: 100%;
    max-width: 500px;
    padding: 30px;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.1);
    text-align: center;
}

h1 {
    color: #24292f;
    margin-bottom: 10px;
}

.subtitle {
    color: #666;
    margin-bottom: 25px;
}

form {
    display: flex;
    gap: 10px;
}

input {
    flex: 1;
    min-width: 0;
    padding: 12px;
    border: 1px solid #ccc;
    border-radius: 8px;
    outline: none;
}

input:focus {
    border-color: #0969da;
}

button {
    padding: 12px 18px;
    background: #24292f;
    color: white;
    border: none;
    border-radius: 8px;
    cursor: pointer;
}

button:hover {
    background: #0969da;
}

#message {
    margin-top: 20px;
    font-weight: bold;
}

.error {
    color: #dc2626;
}

.loading {
    color: #0969da;
}

.profile-card {
    margin-top: 25px;
    padding: 25px;
    background: #f8fafc;
    border-radius: 12px;
}

.profile-card img {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    margin-bottom: 15px;
    border: 4px solid white;
}

.profile-card h2 {
    color: #24292f;
    margin-bottom: 8px;
}

.profile-card p {
    color: #555;
    margin: 10px 0;
    line-height: 1.5;
}

.repos {
    margin: 15px 0;
    font-weight: bold;
    color: #0969da;
}

.profile-card a {
    display: inline-block;
    margin-top: 10px;
    padding: 10px 18px;
    background: #24292f;
    color: white;
    text-decoration: none;
    border-radius: 8px;
}

.profile-card a:hover {
    background: #0969da;
}

@media (max-width: 480px) {
    .container {
        padding: 20px;
    }

    form {
        flex-direction: column;
    }

    button {
        width: 100%;
    }
}
